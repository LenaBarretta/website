---
// Renders nothing when `show` is false, so empty data lists hide their section.
interface Props {
  id: string;
  title: string;
  show?: boolean;
}
const { id, title, show = true } = Astro.props;
---
{show && (
  <section id={id}>
    <h2>{title}</h2>
    <slot />
  </section>
)}

<style>
  section { padding: 2.75rem 0; border-top: 1px solid var(--line); }
</style>
