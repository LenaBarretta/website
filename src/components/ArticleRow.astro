---
// Airy article block: image on the left, text on the right (stacks on phones).
interface Props {
  title: string;
  href: string;
  description?: string;
  image?: string;
  kicker?: string;
  date?: string;
  external?: boolean;
}
const { title, href, description, image, kicker, date, external = false } = Astro.props;
const target = external ? { target: "_blank", rel: "noopener" } : {};
---
<article class:list={["row", { "no-image": !image }]}>
  {image && (
    <a href={href} class="thumb" tabindex="-1" aria-hidden="true" {...target}>
      <img src={image} alt="" loading="lazy" width="480" height="480" />
    </a>
  )}
  <div class="body">
    {(kicker || date) && (
      <div class="kicker">
        {kicker && <span>{kicker}</span>}
        {date && <span class="date">{date}</span>}
      </div>
    )}
    <h3><a href={href} {...target}>{title}</a></h3>
    {description && <p>{description}</p>}
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 12rem) 1fr;
    gap: 2.25rem;
    align-items: center;
    padding: 2.25rem 0;
  }
  .row + .row { border-top: 1px solid var(--line); }
  .row.no-image { grid-template-columns: 1fr; }
  .thumb {
    display: block; border-radius: 14px; overflow: hidden;
    aspect-ratio: 1; background: var(--accent-soft);
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .row:hover .thumb img { transform: scale(1.04); }
  .kicker {
    display: flex; gap: 0.75rem; flex-wrap: wrap;
    font: 600 0.72rem/1 var(--sans); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 0.7rem;
  }
  .kicker .date { color: var(--muted); font-weight: 500; }
  h3 { font-size: 1.3rem; line-height: 1.3; margin: 0 0 0.6rem; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  p {
    margin: 0; color: var(--muted); font-size: 0.98rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 1rem; padding: 1.75rem 0; }
    .thumb { max-width: 14rem; }
  }
</style>
