---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import BrandIcon from "../components/BrandIcon.astro";
import { profile } from "../data/site";
import { header, job, research, personalProjects, skills, education } from "../data/cv";
---
<Base title="CV" description={header.summary.join(" ")}>
  <header class="intro">
    <h1>{header.name}</h1>
    <p class="title">{header.title}</p>
    <ul class="contact-row">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        {header.location}
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M3.5 6l8.5 7 8.5-7" /></svg>
        <a href={`mailto:${header.email}`}>{header.email}</a>
      </li>
      {header.linkedin && (
        <li><a href={header.linkedin}>LinkedIn</a></li>
      )}
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
        <a href={header.website.href}>{header.website.label}</a>
      </li>
    </ul>
    <div class="summary">{header.summary.map((s) => <p>{s}</p>)}</div>
    <div class="actions">
      {profile.cvPdf
        ? <a class="btn" href={profile.cvPdf} download="Elena_Raikova_CV.pdf">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
            Download PDF CV
          </a>
        : <span class="btn" aria-disabled="true">Download PDF CV</span>}
      <a class="btn ghost" href={`mailto:${header.email}`}>Contact</a>
    </div>
  </header>

  <Section id="experience" title="Experience">
    <div class="company">
      <img class="badge" src="/logos/dataart.svg" alt="DataArt logo" width="48" height="48" />
      <div>
        <h3>{job.company} <span class="sep">—</span> {job.title}</h3>
        <div class="muted small">{job.period} · {job.location}</div>
      </div>
    </div>

    <div class="label">{job.projectsLabel}</div>
    <div class="projects">
      {job.projects.map((p) => (
        <article class="proj">
          <div class="proj-head">
            <h4>{p.title}</h4>
          </div>
          <ul class="bullets">{p.bullets.map((b) => <li>{b}</li>)}</ul>
          {p.caseStudy && (
            <a class="case" href={p.caseStudy.href} target="_blank" rel="noopener">
              <img src={p.caseStudy.image} alt="" width="160" height="90" referrerpolicy="no-referrer" />
              <span>
                <span class="case-title">Case study <span aria-hidden="true">↗</span></span>
                <span class="case-src">dataart.com</span>
              </span>
            </a>
          )}
        </article>
      ))}
    </div>

    <p class="earlier"><strong>{job.earlier.label}</strong> {job.earlier.text}</p>
  </Section>

  <Section id="research" title="Independent research and writing">
    <article class="research">
      <a class="r-thumb" href={research.href} tabindex="-1" aria-hidden="true">
        <img src={research.image} alt="" width="640" height="640" loading="lazy" />
      </a>
      <div>
        <div class="r-head">
          <h3><a href={research.href}>{research.title} <span aria-hidden="true">↗</span></a></h3>
          <span class="muted small">{research.period}</span>
        </div>
        <p class="muted">{research.subtitle}</p>
      </div>
    </article>
    <ul class="bullets areas">
      {research.areas.map((a) => <li><strong>{a.area}:</strong> {a.text}</li>)}
    </ul>
  </Section>

  <Section id="personal-projects" title="Personal projects" show={personalProjects.length > 0}>
    <ul class="mini">
      {personalProjects.map((p) => (
        <li>
          {p.image && <img src={p.image} alt="" width="40" height="40" loading="lazy" />}
          <a href={p.href}>{p.name}</a>
          <span class="muted">{p.blurb}</span>
          {p.note && <code>{p.note}</code>}
        </li>
      ))}
    </ul>
  </Section>

  <Section id="skills" title="Skills">
    <dl class="skills">
      {skills.map((s) => (
        <>
          <dt>{s.group}</dt>
          <dd>
            <ul class="chips">
              {s.items.map((i) => (
                <li>{i.icon && <BrandIcon slug={i.icon} />}{i.name}</li>
              ))}
            </ul>
          </dd>
        </>
      ))}
    </dl>
  </Section>

  <Section id="education" title="Education">
    {education.map((e) => (
      <div class="edu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5z" /><path d="M6 11v5c3 2.5 9 2.5 12 0v-5" /></svg>
        <div><strong>{e.degree}</strong><div class="muted">{e.school}</div></div>
      </div>
    ))}
  </Section>
</Base>

<style>
  svg { fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }

  .intro { padding-bottom: 2.75rem; }
  .title { font-size: 1.25rem; font-weight: 300; margin: 0 0 1.25rem; }
  .contact-row { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; color: var(--muted); font-size: 0.93rem; }
  .contact-row li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .contact-row svg { width: 16px; height: 16px; }
  .contact-row a { color: var(--text); text-decoration: none; border-bottom: 1px solid var(--faint); }
  .contact-row a:hover { border-color: var(--text); }
  .summary { font-size: 1.08rem; line-height: 1.7; }
  .summary p { margin: 0; }
  .summary p + p { color: var(--muted); }
  .btn svg { width: 16px; height: 16px; stroke-width: 1.8; }

  /* experience */
  .company { display: flex; gap: 1rem; align-items: center; margin-bottom: 2rem; }
  .badge { flex: none; width: 44px; height: 44px; border-radius: 10px; display: block; }
  .company h3 { margin: 0 0 0.2rem; font-size: 1.15rem; }
  .sep { color: var(--faint); }
  .small { font-size: 0.9rem; }
  .label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; }
  .projects { display: grid; gap: 1rem; }
  .proj { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 1.25rem 1.4rem; }
  .proj-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.75rem; margin-bottom: 0.6rem; }
  h4 { margin: 0; font-size: 1.05rem; font-weight: 500; }
  .bullets { margin: 0; padding-left: 1.1rem; color: var(--muted); font-size: 0.95rem; }
  .bullets li { margin-bottom: 0.35rem; }
  .bullets li::marker { color: var(--faint); }
  .case {
    display: inline-flex; align-items: center; gap: 0.9rem; margin-top: 0.9rem;
    padding: 0.4rem 0.9rem 0.4rem 0.4rem; border-radius: 10px;
    border: 1px solid var(--line); text-decoration: none; transition: border-color 0.2s;
  }
  .case:hover { border-color: var(--faint); }
  .case img { width: 96px; height: 54px; object-fit: cover; border-radius: 6px; display: block; }
  .case > span { display: flex; flex-direction: column; }
  .case-title { color: var(--text); font-size: 0.92rem; font-weight: 500; }
  .case-src { color: var(--muted); font-size: 0.78rem; }
  .earlier { margin: 1.5rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .earlier strong { color: var(--text); font-weight: 500; }

  /* research */
  .research { display: flex; gap: 1.25rem; align-items: center; margin-bottom: 1.25rem; }
  .r-thumb { flex: none; width: 76px; height: 76px; border-radius: 12px; overflow: hidden; }
  .r-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .r-head { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; align-items: baseline; }
  .r-head h3 { margin: 0; }
  .r-head a { text-decoration: none; }
  .research p { margin: 0.2rem 0 0; }
  .areas strong { color: var(--text); font-weight: 500; }

  /* personal projects */
  .mini { list-style: none; padding: 0; margin: 0; }
  .mini li { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.9rem; }
  .mini img { width: 40px; height: 40px; border-radius: 9px; }
  .mini a { font-weight: 500; text-decoration: none; }
  .mini code { font: 0.85rem var(--mono); padding: 0.2rem 0.5rem; border-radius: 6px; background: var(--accent-soft); border: 1px solid var(--line); }

  /* skills */
  .skills { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1rem 1.5rem; margin: 0; }
  .skills dt { font-weight: 500; padding-top: 0.3rem; }
  .skills dd { margin: 0; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips li {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.3rem 0.6rem; border-radius: 8px; font-size: 0.85rem;
    color: var(--muted); background: var(--accent-soft); border: 1px solid var(--line);
  }
  .chips :global(.brand-icon) { color: var(--text); opacity: 0.85; }

  /* education */
  .edu { display: flex; gap: 0.9rem; align-items: flex-start; }
  .edu svg { width: 26px; height: 26px; flex: none; margin-top: 0.1rem; color: var(--muted); }
  .edu strong { font-weight: 500; }

  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; gap: 0.4rem; }
    .skills dd { margin-bottom: 0.9rem; }
  }
</style>
