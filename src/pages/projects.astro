---
import Base from "../layouts/Base.astro";
import { personalProjects } from "../data/site";
---
<Base title="Personal projects" wide>
  <header class="head">
    <h1>Personal projects</h1>
  </header>
  {personalProjects.length > 0 && (
    <section class="projects">
      <div class="grid">
        {personalProjects.map((p) => (
          <article class:list={["proj", { "has-image": p.image }]}>
            {p.image && (
              <a class="thumb" href={p.href} tabindex="-1" aria-hidden="true">
                <img src={p.image} alt="" width="640" height="640" loading="lazy" />
              </a>
            )}
            <div class="body">
              <h3>{p.href ? <a href={p.href}>{p.title} <span aria-hidden="true">↗</span></a> : p.title}</h3>
              <p>{p.summary}</p>
              {p.install && <code class="install">{p.install}</code>}
              {p.tags?.length ? <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul> : null}
              {p.links?.length ? <div class="plinks">{p.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}</div> : null}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

</Base>

<style>
  .head { padding: 1rem 0 2rem; }
  .projects + .projects { margin-top: 3.5rem; }
  h2 { margin-bottom: 1.25rem; }
  .grid { display: grid; gap: 1.25rem; }
  .proj {
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px;
    padding: clamp(1.5rem, 4vw, 2.75rem); max-width: 52rem; transition: border-color 0.2s, transform 0.2s;
  }
  .proj:hover { border-color: var(--accent); transform: translateY(-2px); }
  .proj h3 { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 1rem; }
  .proj h3 a { color: var(--text); text-decoration: none; }
  .proj h3 a:hover { color: var(--accent); }
  .proj p { margin: 0 0 0.5rem; color: var(--muted); font-size: 1.08rem; line-height: 1.7; max-width: 44rem; }
  .proj .tags { margin-top: 1.25rem; }
  .proj.has-image { display: grid; grid-template-columns: 13rem 1fr; gap: 2.25rem; align-items: center; }
  .thumb { display: block; border-radius: 14px; overflow: hidden; aspect-ratio: 1; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .proj:hover .thumb img { transform: scale(1.04); }
  .install {
    display: inline-block; margin-top: 0.75rem; padding: 0.45rem 0.8rem; border-radius: 8px;
    font: 0.92rem var(--mono); color: var(--text); background: var(--accent-soft); border: 1px solid var(--line);
  }
  .plinks { display: flex; gap: 1.25rem; margin-top: 1rem; font-size: 0.95rem; }
  .plinks a { text-decoration: none; color: var(--muted); }
  .plinks a:hover { color: var(--text); }
  @media (max-width: 640px) {
    .proj.has-image { grid-template-columns: 1fr; gap: 1.25rem; }
    .thumb { max-width: 12rem; }
  }
</style>
