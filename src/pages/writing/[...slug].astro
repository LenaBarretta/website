---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <a href="/writing/" class="back">← All writing</a>
    <h1>{post.data.title}</h1>
    <div class="muted meta">{formatDate(post.data.date)}</div>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .back { font-size: 0.9rem; text-decoration: none; }
  h1 { margin-top: 1.25rem; }
  .meta { margin-bottom: 2rem; }
</style>
