---
import Base from "../../layouts/Base.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import { getPosts, formatDate } from "../../lib/posts";
import { externalWriting } from "../../data/site";
import { articles, formatNoteDate } from "../../lib/notes";

const posts = await getPosts();

// Notes from lenatriestounderstand and writing published elsewhere, newest first.
const items = [
  ...articles.map((a) => ({ title: a.title, href: a.href, description: a.description, image: a.image, kicker: a.track, date: a.date })),
  ...externalWriting.map((e) => ({ title: e.title, href: e.href ?? "", description: e.summary, image: e.image, kicker: e.venue, date: e.date ?? "" })),
].sort((a, b) => b.date.localeCompare(a.date));
---
<Base title="Writing" description="Writing on AI, machine learning and ML systems.">
  <h1>Writing</h1>

  {posts.length > 0 && (
    <section>
      {posts.map((p) => (
        <ArticleRow title={p.data.title} href={`/writing/${p.id}/`} description={p.data.description} kicker={p.data.tags[0]} date={formatDate(p.data.date)} />
      ))}
    </section>
  )}

  {items.length > 0 && (
    <section>
      {items.map((i) => (
        <ArticleRow title={i.title} href={i.href} description={i.description} image={i.image} kicker={i.kicker} date={formatNoteDate(i.date)} external />
      ))}
    </section>
  )}
</Base>
